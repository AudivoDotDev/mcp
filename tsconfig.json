{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "vitest.config.ts", "eslint.config.js"]
}
